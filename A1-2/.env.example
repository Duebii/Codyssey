# 기본 Base URL은 https://copa.codyssey.kr 입니다. 다른 환경을 사용할 때만 변경합니다.
CODYSSEY_API_BASE_URL="https://copa.codyssey.kr"

# Codyssey OpenAI 호환 방식으로 발급한 키를 입력합니다.
CODYSSEY_API_KEY="YOUR_CODYSSEY_API_KEY"

# 지도/장소 검색용 Kakao REST API 키를 입력합니다.
KAKAO_REST_API_KEY="YOUR_KAKAO_REST_API_KEY"

# Codyssey API 콘솔 문서 탭에서 지원하는 GPT 모델명을 입력합니다.
CODYSSEY_MODEL="gpt-5-mini"
