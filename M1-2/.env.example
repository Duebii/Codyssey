# Local example only. Copy to .env and fill secret values on your computer.
# Operating-system environment variables take precedence over .env.
APP_ENV=development
# codyssey: course-provided key. openai: personal OpenAI Platform key.
AI_PROVIDER=codyssey

# Backend only. Never include these in frontend build output.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=6000
OPENAI_TIMEOUT_SECONDS=60
OPENAI_REASONING_EFFORT=omit

# Set exactly ONE of JSON or PATH when credentials are ready.
# Local path is relative to this M1-2 directory.
# Example PATH: .secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Comma-separated origins: no wildcard, path, query, or trailing slash.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Public backend address. Local backend is planned on port 8000.
# The frontend will append /api/...; do not add /api here.
API_BASE_URL=http://127.0.0.1:8000
